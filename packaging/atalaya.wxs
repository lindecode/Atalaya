<!--
  Instalador MSI de Atalaya (WiX Toolset 5). Lo compila packaging\distribuir.ps1, que pasa:
    -d AppVersion=<shared\about.py>  -d SourceDir=<build\Atalaya>
  Igual que el .exe de Inno Setup: por usuario (sin administrador) en %LOCALAPPDATA%\Programs\Atalaya, con los
  datos aparte en %LOCALAPPDATA%\Atalaya. Instale uno de los dos, no ambos: comparten carpeta.

  Opciones (propiedades de msiexec), pensadas para despliegues con Intune/GPO:
    DESKTOP_SHORTCUT=1|0  acceso directo en el escritorio (por defecto 1)
    AUTOSTART=1|0         iniciar con Windows junto al reloj, con el monitor de archivos (por defecto 0)
    CYCLE=1|0             analisis periodico cada 5 minutos (por defecto 1)
  Ejemplo: msiexec /i Atalaya-1.0.0.msi /qn AUTOSTART=1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Atalaya" Manufacturer="LindeCode" Version="$(var.AppVersion)" Language="3082" Codepage="1252"
           UpgradeCode="{EE946CFC-6B76-4342-8D27-AA74F513F808}" Scope="perUser" InstallerVersion="500">
    <SummaryInformation Description="Atalaya $(var.AppVersion)" Manufacturer="LindeCode" />
    <!-- Una version nueva desinstala antes la anterior: no quedan modulos viejos mezclados con los nuevos -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="Ya hay una versión más nueva de Atalaya instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AtalayaIcon" SourceFile="$(var.SourceDir)\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AtalayaIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/lindecode/Atalaya" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="DESKTOP_SHORTCUT" Value="1" />
    <Property Id="AUTOSTART" Value="0" />
    <Property Id="CYCLE" Value="1" />
    <!-- Carpeta instalada, guardada en HKCU: RemoveFolderEx la vacia al desinstalar (incluye __pycache__) -->
    <Property Id="APPFOLDER">
      <RegistrySearch Id="AppFolderSearch" Root="HKCU" Key="Software\LindeCode\Atalaya" Name="InstallDir" Type="raw" />
    </Property>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Atalaya" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuFolder" Name="Atalaya" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="StartupFolder" />

    <Feature Id="Main" Title="Atalaya" Level="1">
      <Files Directory="INSTALLFOLDER" Include="$(var.SourceDir)\**" />
      <ComponentRef Id="InstallDirRecord" />
      <ComponentRef Id="MenuShortcuts" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartupShortcut" />
    </Feature>

    <Component Id="InstallDirRecord" Directory="INSTALLFOLDER" Guid="{3B0F9E1D-6C2A-4F57-9E41-7D0B5A2C8E13}">
      <RegistryValue Root="HKCU" Key="Software\LindeCode\Atalaya" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]"
                     KeyPath="yes" />
      <util:RemoveFolderEx On="uninstall" Property="APPFOLDER" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
    </Component>

    <!-- Atalaya vive en la bandeja: pythonw no abre consola y un segundo clic solo abre el panel -->
    <Component Id="MenuShortcuts" Directory="MenuFolder" Guid="{9A4C1E77-2B5D-4E18-A0F3-6D8E2C4B1A90}">
      <Shortcut Id="AppShortcut" Name="Atalaya" Description="Abrir Atalaya (sigue en segundo plano junto al reloj)"
                Target="[INSTALLFOLDER]runtime\pythonw.exe" Arguments="main.py tray" WorkingDirectory="INSTALLFOLDER"
                Icon="AtalayaIcon" />
      <Shortcut Id="CollectShortcut" Name="Recolectar y analizar" Target="[INSTALLFOLDER]start\recolectar.bat"
                WorkingDirectory="INSTALLFOLDER" Icon="AtalayaIcon" />
      <Shortcut Id="DoctorShortcut" Name="Diagnóstico" Target="[INSTALLFOLDER]start\diagnostico.bat"
                WorkingDirectory="INSTALLFOLDER" Icon="AtalayaIcon" />
      <Shortcut Id="PermissionsShortcut" Name="Configurar permisos" Description="Una sola vez, pide administrador"
                Target="[INSTALLFOLDER]start\configurar-permisos.bat" WorkingDirectory="INSTALLFOLDER" Icon="AtalayaIcon" />
      <Shortcut Id="StopShortcut" Name="Detener Atalaya" Target="[INSTALLFOLDER]start\detener.bat"
                WorkingDirectory="INSTALLFOLDER" Icon="AtalayaIcon" />
      <Shortcut Id="UninstallShortcut" Name="Desinstalar Atalaya" Target="[System64Folder]msiexec.exe"
                Arguments="/x [ProductCode]" />
      <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\LindeCode\Atalaya" Name="MenuShortcuts" Type="integer" Value="1"
                     KeyPath="yes" />
    </Component>
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="DESKTOP_SHORTCUT = 1"
               Guid="{C5E2A3F8-1D47-4B96-8A2E-0F6B3D9C7E21}">
      <Shortcut Id="DesktopAppShortcut" Name="Atalaya" Target="[INSTALLFOLDER]runtime\pythonw.exe" Arguments="main.py tray"
                WorkingDirectory="INSTALLFOLDER" Icon="AtalayaIcon" />
      <RegistryValue Root="HKCU" Key="Software\LindeCode\Atalaya" Name="DesktopShortcut" Type="integer" Value="1"
                     KeyPath="yes" />
    </Component>
    <Component Id="StartupShortcut" Directory="StartupFolder" Condition="AUTOSTART = 1"
               Guid="{6F1B8D24-9E3C-4A75-B02D-E8C4A1F5936B}">
      <Shortcut Id="StartupAppShortcut" Name="Atalaya" Target="[INSTALLFOLDER]runtime\pythonw.exe"
                Arguments="main.py tray --no-browser --monitor" WorkingDirectory="INSTALLFOLDER" Icon="AtalayaIcon" />
      <RegistryValue Root="HKCU" Key="Software\LindeCode\Atalaya" Name="StartupShortcut" Type="integer" Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Mismo script que start\automatizacion.bat y el interruptor de Ajustes -->
    <CustomAction Id="ScheduleCycle" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[INSTALLFOLDER]start\lib\automatizacion.ps1&quot; -Accion activar -Minutos 5" />
    <!-- Antes de borrar archivos: detiene bandeja, panel, monitor y ciclos y quita la tarea programada.
         Silencioso como todo desinstalador MSI: conserva datos y permisos (se revierten con configurar-permisos). -->
    <CustomAction Id="StopAtalaya" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[INSTALLFOLDER]start\lib\desinstalar.ps1&quot; -DesdeDesinstalador -Silencioso" />
    <InstallExecuteSequence>
      <Custom Action="StopAtalaya" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ScheduleCycle" After="InstallFiles" Condition="NOT REMOVE AND CYCLE = 1" />
    </InstallExecuteSequence>
  </Package>
</Wix>
